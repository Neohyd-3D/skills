{
  "$description": "Tokens de diseño de {{NAME}}. Fuente única: genera tokens.css y tokens.js (python3 tools/build_tokens.py). Formato W3C DTCG. El valor de otro tema va en $extensions.mode.<tema>. Estos valores son un punto de partida neutro: sustitúyelos por la dirección visual del producto.",
  "$extensions": {
    "doc": {
      "version": "0.1.0",
      "themes": ["dark"],
      "contrast": [
        ["ink", "canvas", 4.5], ["ink", "float", 4.5], ["ink", "surface-2", 4.5],
        ["ink-2", "canvas", 4.5], ["ink-2", "float", 4.5], ["ink-2", "surface-2", 4.5], ["ink-2", "bg", 4.5],
        ["accent-text", "canvas", 4.5], ["accent-text", "float", 4.5], ["accent-text", "surface-2", 4.5],
        ["accent-ink", "accent-fill", 4.5],
        ["danger", "float", 4.5], ["warning", "float", 4.5], ["success", "float", 4.5],
        ["ink-3", "float", 3.0], ["accent", "canvas", 3.0]
      ],
      "categoryCheck": { "group": "category", "label": [0.75, "ink"], "background": [0.09, "canvas"], "min": 4.5 }
    }
  },

  "font": {
    "$type": "fontFamily",
    "sans":    { "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "system-ui", "sans-serif"], "$description": "Interfaz." },
    "display": { "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "Helvetica Neue", "system-ui", "sans-serif"], "$description": "Títulos expresivos (bienvenida, estados vacíos). Cámbiala si la dirección visual lo pide." },
    "mono":    { "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "Valores, medidas, ID." }
  },

  "color": {
    "$type": "color",
    "accent":      { "$value": "#0071e3", "$extensions": { "mode": { "dark": "#0a84ff" } }, "$description": "Tinte de selección y foco." },
    "accent-text": { "$value": "#0066cc", "$extensions": { "mode": { "dark": "#409cff" } }, "$description": "Acento cuando es texto." },
    "accent-fill": { "$value": "#0071e3", "$extensions": { "mode": { "dark": "#0a6fdb" } }, "$description": "Relleno del botón principal." },
    "accent-ink":  { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#ffffff" } }, "$description": "Texto sobre accent-fill." },
    "accent-soft": { "$value": "rgba(0, 113, 227, 0.12)", "$extensions": { "mode": { "dark": "rgba(10, 132, 255, 0.20)" } } },

    "canvas":    { "$value": "#fbfbfd", "$extensions": { "mode": { "dark": "#161617" } }, "$description": "Fondo de la superficie principal." },
    "bg":        { "$value": "#f5f5f7", "$extensions": { "mode": { "dark": "#1c1c1e" } }, "$description": "Fondo de ventanas secundarias." },
    "float":     { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#232325" } }, "$description": "Piezas flotantes, menús, paneles." },
    "surface":   { "$value": "#ffffff", "$extensions": { "mode": { "dark": "#232325" } } },
    "surface-2": { "$value": "#f0f0f2", "$extensions": { "mode": { "dark": "#2a2a2d" } }, "$description": "Hover, campos." },
    "surface-3": { "$value": "#e8e8ed", "$extensions": { "mode": { "dark": "#333336" } }, "$description": "Esqueletos, pulsado." },

    "ink":   { "$value": "#1d1d1f", "$extensions": { "mode": { "dark": "#f5f5f7" } }, "$description": "Texto principal." },
    "ink-2": { "$value": "#636366", "$extensions": { "mode": { "dark": "#a1a1a6" } }, "$description": "Texto secundario (AA)." },
    "ink-3": { "$value": "#86868b", "$extensions": { "mode": { "dark": "#8e8e93" } }, "$description": "Solo decorativo o desactivado." },

    "line":        { "$value": "rgba(0, 0, 0, 0.09)", "$extensions": { "mode": { "dark": "rgba(255, 255, 255, 0.09)" } } },
    "line-strong": { "$value": "rgba(0, 0, 0, 0.16)", "$extensions": { "mode": { "dark": "rgba(255, 255, 255, 0.16)" } } },
    "scrim":       { "$value": "rgba(0, 0, 0, 0.32)", "$extensions": { "mode": { "dark": "rgba(0, 0, 0, 0.52)" } } },

    "danger":  { "$value": "#d70015", "$extensions": { "mode": { "dark": "#ff6961" } } },
    "warning": { "$value": "#b25000", "$extensions": { "mode": { "dark": "#ffb340" } } },
    "success": { "$value": "#1a7431", "$extensions": { "mode": { "dark": "#30d158" } } },

    "category": {
      "$description": "Paleta para agrupar o etiquetar (opcional). Bórrala si el producto no la necesita.",
      "uno":    { "$value": "#4f6d8a" },
      "dos":    { "$value": "#a4523a" },
      "tres":   { "$value": "#5f7d4c" },
      "cuatro": { "$value": "#7d5a85" }
    },

    "brand": {
      "$description": "Marca (temporal o existente). Normalmente no sustituye al acento de la interfaz.",
      "primario": { "$value": "#1d1d1f" }
    }
  },

  "size": {
    "$type": "dimension",
    "text": {
      "caption":  { "$value": "11px" },
      "footnote": { "$value": "11.5px" },
      "callout":  { "$value": "12.5px" },
      "body":     { "$value": "13px", "$description": "Cuerpo de interfaz de escritorio (en móvil suele ser 16–17)." },
      "title-3":  { "$value": "15px" },
      "title-2":  { "$value": "17px" },
      "title-1":  { "$value": "20px" },
      "large":    { "$value": "26px" },
      "display":  { "$value": "40px" }
    },
    "space": {
      "1": { "$value": "2px" }, "2": { "$value": "4px" }, "3": { "$value": "6px" }, "4": { "$value": "8px" },
      "5": { "$value": "10px" }, "6": { "$value": "12px" }, "7": { "$value": "14px" }, "8": { "$value": "16px" },
      "9": { "$value": "20px" }, "10": { "$value": "24px" }, "11": { "$value": "32px" }, "12": { "$value": "48px" }
    },
    "radius": {
      "xs": { "$value": "5px" }, "sm": { "$value": "7px" }, "md": { "$value": "10px" },
      "lg": { "$value": "14px" }, "xl": { "$value": "18px" }, "pill": { "$value": "999px" }
    },
    "control": {
      "sm": { "$value": "24px" }, "md": { "$value": "28px" }, "lg": { "$value": "36px" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "sm": { "$value": "0 1px 2px rgba(0,0,0,.06)", "$extensions": { "mode": { "dark": "0 1px 2px rgba(0,0,0,.4)" } } },
    "md": { "$value": "0 1px 2px rgba(0,0,0,.05), 0 6px 18px rgba(0,0,0,.06)", "$extensions": { "mode": { "dark": "0 1px 2px rgba(0,0,0,.35), 0 8px 22px rgba(0,0,0,.3)" } } },
    "lg": { "$value": "0 2px 6px rgba(0,0,0,.06), 0 24px 60px rgba(0,0,0,.16)", "$extensions": { "mode": { "dark": "0 2px 8px rgba(0,0,0,.4), 0 30px 70px rgba(0,0,0,.55)" } } }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" }, "base": { "$value": "200ms" }, "slow": { "$value": "320ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "out":    { "$value": [0.2, 0.8, 0.2, 1] },
      "spring": { "$value": [0.2, 0.9, 0.3, 1.3] }
    }
  },

  "layer": {
    "$type": "number",
    "canvas": { "$value": 0 }, "float": { "$value": 20 }, "card": { "$value": 21 },
    "preview": { "$value": 900 }, "sheet": { "$value": 950 }, "menu": { "$value": 1000 }, "toast": { "$value": 1100 }
  }
}
